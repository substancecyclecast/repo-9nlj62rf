# SnabAgent — Alibaba Cloud (Qwen) environment
# Copy to project root as `.env` on the ECS instance:  cp deploy/alibaba/.env.alibaba.example .env
# Only LLM_QWEN_API_KEY is strictly required to bring the agents online.

APP_ENV=prod
DEMO_MODE=true
LOG_LEVEL=INFO

# --- Secrets: change these before a real deployment ---
SECRET_KEY=change-me-to-a-long-random-string
API_KEY=change-me-to-a-long-random-string
POSTGRES_USER=snab
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=snabagent
REDIS_PASSWORD=

# --- Database / infra (in-cluster service names from docker-compose) ---
DATABASE_URL=postgresql+asyncpg://snab:change-me-strong@postgres:5432/snabagent
QDRANT_HOST=qdrant
QDRANT_PORT=6333
REDIS_URL=redis://redis:6379/0

# --- LLM: Qwen Cloud (Alibaba DashScope, OpenAI-compatible) ---
LLM_PRIMARY=qwen
LLM_FALLBACK=qwen
LLM_VERIFIER=qwen
LLM_VERIFIER_FALLBACK=qwen
LLM_QWEN_API_KEY=sk-your-dashscope-key
LLM_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_QWEN_MODEL=qwen-max
LLM_QWEN_VERIFIER_MODEL=qwen-plus
LLM_QWEN_FAST_MODEL=qwen-flash
LLM_ENABLE_QWEN_IN_PROD=true

# --- Embeddings ---
# fake keeps the demo dependency-light. For higher-quality retrieval set to
# sentence-transformers (needs more RAM) once the box is sized for it.
EMBEDDING_BACKEND=fake
EMBEDDING_DIM=384

# --- Regulatory / sourcing demo defaults ---
SPARK_MOCK_MODE=true
