# Mandate — Environment Configuration
# Copy to .env and fill in values for production deployment.
# In sandbox mode (default), no keys are required — everything works out of the box.

# === Core ===
MANDATE_ENVIRONMENT=local            # local | staging | production
MANDATE_DATABASE_URL=sqlite:///./data/mandate.db  # or postgresql+psycopg://user:pass@host/db
MANDATE_INTEGRATION_MODE=sandbox     # sandbox | live

# === Agent / LLM ===
MANDATE_LLM_PROVIDER=deterministic   # deterministic | anthropic | openai
MANDATE_ANTHROPIC_API_KEY=           # sk-ant-... (only for LLM mode)
MANDATE_OPENAI_API_KEY=              # sk-... (only for LLM mode)
MANDATE_LLM_MODEL=claude-sonnet-4

# === Stellar ===
MANDATE_STELLAR_NETWORK=testnet      # testnet | public
MANDATE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
MANDATE_STELLAR_SOROBAN_RPC=https://soroban-testnet.stellar.org
MANDATE_STELLAR_SIGNING_KEY=         # S... (Stellar secret key for auto-signing)

# === Safe (EVM Multisig) ===
MANDATE_SAFE_TX_SERVICE_BASE=https://safe-transaction-base.safe.global
MANDATE_SAFE_MODULE_ADDRESS=         # Deployed Safe module contract address
MANDATE_SAFE_SIGNER_KEY=             # Private key for co-signer module (0x...)

# === Bridge.xyz (Global Off-Ramp) ===
MANDATE_BRIDGE_API_BASE=https://api.bridge.xyz
MANDATE_BRIDGE_API_KEY=              # Bridge.xyz API key

# === Cowrie Exchange (Nigeria: USDC→NGN) ===
MANDATE_COWRIE_API_BASE=https://api.cowrie.exchange
MANDATE_COWRIE_API_KEY=              # Cowrie API key

# === Flutterwave (Pan-Africa Payments) ===
MANDATE_FLUTTERWAVE_API_BASE=https://api.flutterwave.com/v3
MANDATE_FLUTTERWAVE_SECRET_KEY=      # Flutterwave secret key

# === YellowCard (Africa Crypto Off-Ramp) ===
MANDATE_YELLOWCARD_API_BASE=https://api.yellowcard.io/v1
MANDATE_YELLOWCARD_API_KEY=          # YellowCard API key
MANDATE_YELLOWCARD_SECRET_KEY=       # YellowCard secret key

# === Li.Fi (Swap Aggregator) ===
MANDATE_LIFI_API_BASE=https://li.quest/v1
MANDATE_LIFI_API_KEY=                # Li.Fi API key

# === Compliance ===
MANDATE_CHAINALYSIS_API_BASE=https://api.chainalysis.com/api/kyt/v2
MANDATE_CHAINALYSIS_API_KEY=         # Chainalysis KYT API key

# === Authentication ===
MANDATE_AUTH_ENABLED=false           # Set to true for production
MANDATE_PRIVY_APP_ID=                # Privy app ID (from dashboard.privy.io)
MANDATE_PRIVY_APP_SECRET=            # Privy app secret
MANDATE_JWT_SECRET=mandate-dev-secret-change-in-production
MANDATE_JWT_ALGORITHM=HS256
MANDATE_JWT_EXPIRY_HOURS=24

# === CORS ===
MANDATE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example: MANDATE_CORS_ORIGINS=https://app.mandate.finance,https://mandate.vercel.app

# === Treasury Policy Defaults ===
MANDATE_BASE_STABLECOIN=USDC
MANDATE_MIN_OPERATING_RESERVE_USD=50000.0
MANDATE_IDLE_YIELD_THRESHOLD_USD=100000.0
MANDATE_MAX_AGENT_AUTONOMOUS_TRANSFER_USD=25000.0

# === Rate Limiting (DDoS protection; off by default) ===
MANDATE_RATE_LIMIT_ENABLED=false     # Set true on a public API
MANDATE_RATE_LIMIT_PER_MINUTE=120

# === Event Notifications (Slack / Telegram) ===
# If unset, deliveries are still recorded to the outbox with status "skipped".
MANDATE_SLACK_WEBHOOK_URL=           # https://hooks.slack.com/services/...
MANDATE_TELEGRAM_BOT_TOKEN=          # Telegram bot token
MANDATE_TELEGRAM_CHAT_ID=            # Target chat id

# === Billing ===
MANDATE_BILLING_TAKE_RATE_BPS=25     # 25 bps = 0.25% of settled volume
MANDATE_BILLING_PLATFORM_FEE_USD=2000.0
MANDATE_BILLING_CURRENCY=USD
