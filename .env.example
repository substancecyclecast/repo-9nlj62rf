# ─── Общие ──────────────────────────────────────────────────────
APP_ENV=dev                  # dev | staging | prod
LOG_LEVEL=INFO
SECRET_KEY=change_me_to_random_64chars_in_prod
API_KEY=dev-only-key-change-in-prod  # X-API-Key для FastAPI; в prod должно быть рандомным
SERVICE_PUBLIC_URL=http://localhost:8000
DEMO_MODE=true               # true: укорачиваем таймауты ожидания почты до 30 сек
STREAMLIT_ADMIN_PASSWORD=demo  # пароль на вход в Streamlit-дашборд

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=snabagent
POSTGRES_USER=snab
POSTGRES_PASSWORD=snab_dev_only
DATABASE_URL=postgresql+asyncpg://snab:snab_dev_only@postgres:5432/snabagent

# ─── Qdrant ─────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_NSI_COLLECTION=nsi
QDRANT_SUPPLIERS_COLLECTION=suppliers

# ─── Redis (Celery broker / кэш) ────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── LLM ────────────────────────────────────────────────────────
# fake — встроенный детерминированный мок для оффлайн-демо/тестов
LLM_PRIMARY=fake              # fake | yandex | gigachat | llama | openai | qwen
LLM_FALLBACK=fake
LLM_VERIFIER=fake             # должен ОТЛИЧАТЬСЯ от PRIMARY в проде
LLM_VERIFIER_FALLBACK=fake    # отдельный fallback для verifier (НЕ совпадает с PRIMARY)
#
# ── Рекомендованная конфигурация для Qwen Cloud (хакатон) ──
#   LLM_PRIMARY=qwen
#   LLM_FALLBACK=qwen
#   LLM_VERIFIER=qwen          # тот же провайдер, но ДРУГАЯ модель (см. ниже) → anti-hallucination сохраняется
#   LLM_VERIFIER_FALLBACK=qwen
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SEC=45
LLM_MAX_RETRIES=3

# YandexGPT 5 Pro
LLM_YC_FOLDER_ID=
LLM_YC_AUTH_TOKEN=
LLM_YC_LLM_MODEL=yandexgpt/latest
LLM_YC_EMBEDDING_MODEL=text-search-doc/latest

# GigaChat 2 Pro
LLM_GIGACHAT_AUTH_KEY=
LLM_GIGACHAT_SCOPE=GIGACHAT_API_CORP
LLM_GIGACHAT_MODEL=GigaChat-2-Pro
LLM_GIGACHAT_VERIFY_SSL=false

# Llama 3.3 70B (Together AI / RunPod / vLLM)
LLM_LLAMA_BASE_URL=https://api.together.xyz/v1
LLM_LLAMA_API_KEY=
LLM_LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# OpenAI (DEV ONLY, с PII masking!)
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4.1
LLM_ENABLE_OPENAI_IN_PROD=false

# Qwen Cloud (Alibaba DashScope, OpenAI-compatible) — основной провайдер для хакатона
LLM_QWEN_API_KEY=
# Глобальный/Singapore endpoint. China-регион: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_QWEN_MODEL=qwen-max            # reasoning (primary): qwen-max | qwen3-max | qwen-plus
LLM_QWEN_VERIFIER_MODEL=qwen-plus  # verifier: ДОЛЖНА отличаться от QWEN_MODEL
LLM_QWEN_FAST_MODEL=qwen-flash     # быстрые агенты (опционально)
LLM_ENABLE_QWEN_IN_PROD=true

# ─── Embeddings ─────────────────────────────────────────────────
# fake — компактные хеш-эмбеддинги для оффлайн-демо (не требуют PyTorch)
EMBEDDING_BACKEND=fake        # fake | sentence-transformers | yandex
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=384

# ─── Email (Mailcow / MailHog / Mailtrap) ───────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agent@demo.snabagent.ru
SMTP_USE_TLS=false

IMAP_HOST=mailhog
IMAP_PORT=1143
IMAP_USER=agent@demo.snabagent.ru
IMAP_PASSWORD=
IMAP_USE_SSL=false
IMAP_POLL_INTERVAL_SEC=30

DEMO_EMAIL_DOMAIN=demo.snabagent.ru

# ─── n8n ────────────────────────────────────────────────────────
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_WEBHOOK_ESCALATION=http://n8n:5678/webhook/escalation

# ─── Sourcing ───────────────────────────────────────────────────
SPARK_MOCK_MODE=true
SPARK_API_KEY=
WEB_SCRAPER_USER_AGENT=SnabAgentBot/0.1 (https://snabagent.ru/bot)
WEB_SCRAPER_TIMEOUT_SEC=10
WEB_SCRAPER_MAX_PAGES=5

# ─── Регуляторный фильтр ────────────────────────────────────────
REGULATORY_BLOCK_AFTER_TENDER_PUBLISHED=true
REGULATORY_MAX_UNREGULATED_AMOUNT_RUB=1000000
REGULATORY_ALLOWED_CATEGORIES=["mro","it","consumables","services","spot_metals","metals","chemistry"]

# ─── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ESCALATION_CHAT_ID=

# ─── Streamlit ──────────────────────────────────────────────────
STREAMLIT_API_BASE=http://api:8000
STREAMLIT_ADMIN_PASSWORD=demo_only_change_me

# ─── Sentry ─────────────────────────────────────────────────────
SENTRY_DSN=

# ─── OAuth2 SSO ────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_AZURE_CLIENT_ID=
OAUTH_AZURE_CLIENT_SECRET=
OAUTH_AZURE_TENANT_ID=common

# ─── SAML SSO ──────────────────────────────────────────────────
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_CERT=

# ─── Production / Deploy ────────────────────────────────────────
DOMAIN=demo.snabagent.ru
REDIS_PASSWORD=
GRAFANA_ADMIN_PASS=admin
FLOWER_USER=admin
FLOWER_PASSWORD=changeme
TELEGRAM_ALERTMANAGER_CHAT_ID=

# ─── CORS (добавьте свой домен) ────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8501"]
FRONTEND_URL=http://localhost:5173
